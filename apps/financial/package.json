{
  "name": "financial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check:api": "NODE_USE_ENV_PROXY=1 node scripts/check-api.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "visual:local": "node ../../scripts/visual-linux.mjs financial",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "check:visual-coverage": "node scripts/check-visual-coverage.mjs",
    "visual:baseline:import": "node scripts/visual-baselines.mjs import",
    "test:ci-tools": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@internationalized/date": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "shadcn-svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "catalog:",
    "@lucide/svelte": "catalog:",
    "@neondatabase/postgrest-js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/svelte-query": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:",
    "decimal.js": "catalog:",
    "svelte": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:",
    "@hasbai/ui": "workspace:*",
    "@hasbai/auth": "workspace:*",
    "@hasbai/data": "workspace:*"
  }
}
