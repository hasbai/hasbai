{
  "version": 1,
  "scope": "真实Shell、路由与Repository的合成数据测试；正常态门禁，不代表全部设备状态组合或真实登录。",
  "inventory": {
    "root": "src/pages",
    "suffix": ".svelte"
  },
  "baselineTemplate": "e2e/__screenshots__/linux-ci-{project}/{spec}/{snapshot}",
  "baselineDirectories": [
    "e2e/__screenshots__/linux-ci-iphone",
    "e2e/__screenshots__/linux-ci-iphone-se",
    "e2e/__screenshots__/linux-ci-android",
    "e2e/__screenshots__/linux-ci-desktop"
  ],
  "pages": [
    {
      "source": "src/pages/Overview.svelte",
      "scenarios": [
        "overview",
        "overview-loading",
        "overview-empty",
        "overview-error",
        "assets-report",
        "cash-report",
        "profit-report",
        "profit-dense",
        "mobile-navigation-action",
        "ledger-access"
      ]
    },
    {
      "source": "src/pages/Transactions.svelte",
      "scenarios": [
        "transactions",
        "transactions-loading",
        "transactions-empty",
        "transactions-error",
        "transaction-filters"
      ]
    },
    {
      "source": "src/pages/Editor.svelte",
