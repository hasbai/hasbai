    },
    {
      "source": "src/pages/Settings.svelte",
      "scenarios": ["settings"]
    },
    {
      "source": "src/pages/Accounts.svelte",
      "scenarios": [
        "accounts",
        "accounts-loading",
        "accounts-empty",
        "accounts-error",
        "account-short-dark"
      ]
    }
