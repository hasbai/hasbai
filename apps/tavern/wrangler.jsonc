{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tavern",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "routes": [
    {
      "pattern": "tavern.hasbai.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "secrets": {
    "required": [
      "AIG_RP_RUN_TOKEN",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "AUTH0_DOMAIN": "auth.hasbai.xyz",
    "AUTH0_AUDIENCE": "https://financial.hasbai.xyz/api",
    "AIG_GATEWAY_ID": "default",
    "TELEGRAM_BOT_USERNAME": "saki_main_bot"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "PROMPTS",
      "id": "d0ed2b03c1be475fa8ae463723d33c05"
    }
  ],
  "version_metadata": {
    "binding": "VERSION"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tavern",
      "database_id": "1652e81e-ce58-4b23-bb24-020928d89546",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tavern"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "TavernSession"
      },
      {
        "name": "MESSAGE_INBOX",
        "class_name": "MessageInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "session-v1",
      "new_sqlite_classes": [
        "TavernSession"
      ]
    },
    {
      "tag": "messaging-v1",
      "new_sqlite_classes": [
        "MessageInbox"
      ]
    }
  ],
  "services": [
    {
      "binding": "IMAGE_SERVICE",
      "service": "images"
    }
  ]
}
