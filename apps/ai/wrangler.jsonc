{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "routes": [{"pattern": "ai.hasbai.xyz", "custom_domain": true}],
  "assets": {"directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/v1/*", "/internal/*", "/health"]},
  "vars": {"CLOUDFLARE_ACCOUNT_ID": "5cecc63c78acf8f5473f8745f4244448", "AIG_GATEWAY_ID": "default", "DEFAULT_CHAT_MODEL": "", "TRANSLATE_MODEL": ""},
  "secrets": {"required": ["AIG_RUN_TOKEN", "CF_AI_MANAGEMENT_TOKEN"]},
  "ai": {"binding": "AI", "remote": true},
  "version_metadata": {"binding": "VERSION"},
  "observability": {"enabled": true, "redact_query_string": true, "logs": {"enabled": true, "invocation_logs": true}, "traces": {"enabled": true, "head_sampling_rate": 0.01}}
}
