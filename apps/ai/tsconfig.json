{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "worker",
    "worker-env.d.ts",
    "vite.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
