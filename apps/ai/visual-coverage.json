    "suffix": ".svelte"
  },
  "baselineDirectories": [
    "e2e/__screenshots__/linux-ci/desktop",
    "e2e/__screenshots__/linux-ci/mobile",
    "e2e/__screenshots__/linux-ci/dark",
    "e2e/__screenshots__/linux-ci/short"
  ],
  "baselineTemplate": "e2e/__screenshots__/linux-ci/{project}/{snapshot}",
  "pages": [
    {
      "source": "src/App.svelte",
