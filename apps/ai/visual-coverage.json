        "use"
      ]
    },
    {
      "source": "src/Manager.svelte",
      "scenarios": [
        "manage"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "use",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/ai.spec.ts",
          "test": "ordinary user streams a reply and retains the prompt after cancellation",
          "projects": [
            "desktop",
            "mobile",
            "dark",
            "short"
          ],
          "snapshots": [
            "workbench.png"
          ]
        }
      ]
    },
    {
      "id": "manage",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/ai.spec.ts",
          "test": "admin manages providers and write-only BYOK keys",
          "projects": [
            "desktop",
            "mobile",
            "dark",
            "short"
          ],
          "snapshots": [
            "management.png",
            "key-form.png"
          ]
        }
