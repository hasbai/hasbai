{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "images",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "routes": [
    {
      "pattern": "images.hasbai.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/images/*",
      "/health"
    ]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "image"
    }
  ],
  "images": { "binding": "IMAGE_TRANSFORM" },
  "version_metadata": {
    "binding": "VERSION"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "AIG_IMAGE_RUN_TOKEN"
    ]
  },
  "send_metrics": false
}
