  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5174",
    "build": "vite build && node scripts/check-worker-startup.mjs",
    "typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
